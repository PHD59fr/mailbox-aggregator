APP_ENV=development
# Set these to the host account that owns ./data before building with Compose.
APP_UID=1000
APP_GID=1000
APP_DATA_DIR=./data
APP_LISTEN_ADDR=:8080
# Optional public web URL displayed in mail client settings (HTTPS in production).
# DNS and the HTTPS reverse proxy must be configured separately.
APP_PUBLIC_URL=
# Compose sets memory and swap to the same bound, preventing container swap.
APP_MEMORY_LIMIT=512m
# Close public account creation after provisioning the intended users.
REGISTRATION_DISABLED=false
LOG_LEVEL=info
SESSION_IDLE_TIMEOUT=30m
SESSION_MAX_LIFETIME=12h
REAUTH_LIFETIME=5m
REQUEST_TIMEOUT=30s
MAX_REQUEST_BYTES=2097152
MAX_VAULT_FILE_BYTES=1048576
# Per incoming/outgoing identity collection; also used by activation and monitoring.
MAX_ACCOUNTS=20
SESSION_COOKIE_SECURE=false
TRUSTED_PROXIES=
ALLOWED_MAIL_PORTS=143,465,587,993
ALLOW_PRIVATE_MAIL_SERVERS=false
ALLOWED_MAIL_CIDRS=
# Optional externally managed OPAQUE setup. Leave empty on a new installation:
# the app generates APP_DATA_DIR/opaque_server_setup once, with mode 0600,
# then reuses it. Back up that file with the account data; never replace it.
# Existing deployments may keep their original explicit value here.
OPAQUE_SERVER_SETUP=

# Optional client-facing IMAPS/SMTPS gateways (disabled in the base Compose file).
# Use compose.proxy.yaml to publish standard TLS ports 993 and 465.
# Shared DNS name or IP used by clients; optional when separate names are set.
# With no public mail hostname, both gateways remain disabled.
MAIL_PROXY_HOSTNAME=
# Optional per-protocol names, overriding MAIL_PROXY_HOSTNAME.
# The shared TLS certificate must cover every enabled protocol's name.
IMAP_PROXY_HOSTNAME=
SMTP_PROXY_HOSTNAME=
# Leave unset for a persistent Docker volume with an automatically generated
# local certificate (must be trusted in each mail client). To use your own
# certificate, set a directory containing fullchain.pem and privkey.pem.
# MAIL_PROXY_CERTS_DIR=./certs
# Native/docker run: enable independently. Leave TLS paths empty to generate
# and reuse a local certificate in APP_DATA_DIR/proxy-certs at startup.
# IMAP_PROXY_ENABLED=false
# SMTP_PROXY_ENABLED=false
IMAP_PROXY_LISTEN_ADDR=:1993
SMTP_PROXY_LISTEN_ADDR=:1465
MAIL_PROXY_TLS_CERT=
MAIL_PROXY_TLS_KEY=

# Optional browser-session OAuth. Register these exact callback paths with
# Google/Microsoft under APP_PUBLIC_URL (HTTPS in production):
# /api/v1/oauth/google/callback and /api/v1/oauth/microsoft/callback.
# These application secrets never replace the user's encrypted refresh token.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
# Optional read-only connectors. Disabled routes return CONNECTOR_DISABLED.
# Add only the required destination ports to ALLOWED_MAIL_PORTS explicitly:
# CardDAV HTTPS: 443; LDAPS: 636; LDAP required STARTTLS: 389; Sieve: 4190.
# Private destinations still require a precise ALLOWED_MAIL_CIDRS exception.
CARDDAV_ENABLED=false
LDAP_ENABLED=false
SIEVE_ENABLED=false
# Also enable People API and request contacts.readonly consent when connecting.
GOOGLE_CONTACTS_ENABLED=false
