APP_ENV=development
# Set these to the host account that owns ./data before building with Compose.
APP_UID=1000
APP_GID=1000
APP_DATA_DIR=./data
APP_LISTEN_ADDR=:8080
# Compose sets memory and swap to the same bound, preventing container swap.
APP_MEMORY_LIMIT=512m
# Close public account creation after provisioning the intended users.
REGISTRATION_DISABLED=false
LOG_LEVEL=info
SESSION_IDLE_TIMEOUT=30m
SESSION_MAX_LIFETIME=12h
REAUTH_LIFETIME=5m
REQUEST_TIMEOUT=30s
MAX_REQUEST_BYTES=2097152
MAX_VAULT_FILE_BYTES=1048576
# Per incoming/outgoing identity collection; also used by activation and monitoring.
MAX_ACCOUNTS=20
SESSION_COOKIE_SECURE=false
TRUSTED_PROXIES=
ALLOWED_MAIL_PORTS=143,465,587,993
ALLOW_PRIVATE_MAIL_SERVERS=false
ALLOWED_MAIL_CIDRS=
# Optional externally managed OPAQUE setup. Leave empty on a new installation:
# the app generates APP_DATA_DIR/opaque_server_setup once, with mode 0600,
# then reuses it. Back up that file with the account data; never replace it.
# Existing deployments may keep their original explicit value here.
OPAQUE_SERVER_SETUP=

# Optional client-facing IMAPS/SMTPS gateways (disabled in the base Compose file).
# Use compose.proxy.yaml to publish standard TLS ports 993 and 465.
# DNS name or IP used by clients. If empty, both proxies are disabled with a
# startup message; webmail still starts and no certificate is generated.
MAIL_PROXY_HOSTNAME=
# Leave unset for a persistent Docker volume with an automatically generated
# local certificate (must be trusted in each mail client). To use your own
# certificate, set a directory containing fullchain.pem and privkey.pem.
# MAIL_PROXY_CERTS_DIR=./certs
# Native/docker run: enable independently. Leave TLS paths empty to generate
# and reuse a local certificate in APP_DATA_DIR/proxy-certs at startup.
# IMAP_PROXY_ENABLED=false
# SMTP_PROXY_ENABLED=false
IMAP_PROXY_LISTEN_ADDR=:1993
SMTP_PROXY_LISTEN_ADDR=:1465
MAIL_PROXY_TLS_CERT=
MAIL_PROXY_TLS_KEY=
