+package smtp
+import("strings";"testing";"time";"fmt";"bytes";"github.com/example/mail-aggregator/internal/mail")
+func TestReauditHeadersRespect998Bytes(t *testing.T){
+ for _,subject:=range []string{strings.Repeat("a",998),strings.Repeat("é",300)}{t.Run(fmt.Sprint(len(subject)),func(t *testing.T){
+ m,err:=BuildMessage(mail.Identity{Email:"sender@example.test"},mail.Draft{To:[]mail.Address{{Email:"to@example.test"}},Subject:subject,Text:"hello"},time.Now());if err!=nil{t.Fatal(err)}
+ headers:=bytes.SplitN(m.Data,[]byte("\r\n\r\n"),2)[0]
+ for _,line:=range bytes.Split(headers,[]byte("\r\n")){if len(line)>998{t.Errorf("header length=%d, prefix=%q",len(line),line[:25])}}
+ })}
+}
