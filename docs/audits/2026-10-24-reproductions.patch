+func TestReauditSingleAccountActivationPreservesOtherAccounts(t *testing.T){
+ f:=newAPIFixtureWithReader(t,nil,fakeReader{list:func(context.Context,imap.Configuration,uint32,uint32)(imap.MessagePage,error){return imap.MessagePage{},nil}})
+ _,token,view:=f.addUser(t,"concurrent@example.test")
+ for _,id:=range []string{"A","B"}{body:=[]byte(fmt.Sprintf(`{"lock_revision":0,"lifetime_seconds":300,"accounts":{"%s":{"host":"8.8.8.8","port":993,"security":"tls","username":"synthetic","password":"synthetic"}}}`,id));r:=perform(f,"POST","/api/v1/session/credentials",token,view.CSRFToken,body);if r.Code!=200{t.Fatalf("activation %s: %d %s",id,r.Code,r.Body.String())}}
