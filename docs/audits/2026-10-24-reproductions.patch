+import {beforeEach,it,expect,vi} from 'vitest'
+import {createPinia,setActivePinia} from 'pinia'
+import {useSessionStore} from '../stores/session'
+import {encryptExportBundle,exportUserData,importUserData,type ExportBundle} from './useImportExport'
+vi.mock('@noble/hashes/argon2.js',()=>({argon2id:()=>new Uint8Array(32).fill(9)}))
+beforeEach(()=>{setActivePinia(createPinia());const s=useSessionStore();s.authenticated=true;s.userID='user';s.vmk=new Uint8Array(32).fill(1)})
+const bundle=():ExportBundle=>({version:1,exported_at:new Date().toISOString(),accounts:{},smtp:{},preferences:{}})
+it('reaudit: imports must supply the revision required by the real API',async()=>{
+ const fetcher=vi.fn(async(_path:unknown,init?:RequestInit)=>new Headers(init?.headers).has('If-Match') ? new Response(null,{status:204}) : new Response(JSON.stringify({error:{code:'REVISION_REQUIRED',message:'If-Match is required.'}}),{status:428}))
+ vi.stubGlobal('fetch',fetcher)
+ const data=await encryptExportBundle(bundle(),'password123')
+ await expect(importUserData(data,'password123')).resolves.toBeUndefined()
+})
+it('reaudit: export must fail when a vault file cannot be fetched',async()=>{
+ vi.stubGlobal('fetch',vi.fn().mockRejectedValue(new TypeError('Network failure')))
+ await expect(exportUserData('password123')).rejects.toThrow()
+})
+it('reaudit: export must support valid vault collections beyond the JS argument limit',async()=>{
+ const b=bundle();b.preferences={note:'a'.repeat(200000)}
+ await expect(encryptExportBundle(b,'password123')).resolves.toEqual(expect.any(String))
+})
