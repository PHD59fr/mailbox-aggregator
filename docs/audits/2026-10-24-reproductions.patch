+func TestReauditScannerDetectsBinaryAndLongLine(t *testing.T){for _,prefix:=range []string{"\x00",strings.Repeat("a",70000)}{t.Run("prefix",func(t *testing.T){dir:=t.TempDir();os.WriteFile(filepath.Join(dir,"leak.dat"),[]byte(prefix+"RE_AUDIT_SECRET"),0600);s:=NewScanner();s.RootDirs=[]string{dir};s.TempDirs=nil;s.LogDirs=nil;r,e:=s.Scan([]string{"RE_AUDIT_SECRET"});if e!=nil{t.Fatal(e)};if len(r)==0{t.Fatal("persisted marker missed and no scan error returned")}})}}
+func TestReauditHelpersRejectUnauthorized(t *testing.T){calls:=0;s:=httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){calls++;w.WriteHeader(401)}));defer s.Close();activateCredentials(t,s.URL,"invalid","invalid");readMessageWithRetry(t,s.URL,"invalid","invalid",1);sendMessageWithRetry(t,s.URL,"invalid","subject","body",1);forwardMessageWithRetry(t,s.URL,"invalid",1);t.Logf("All %d requests returned 401; current MA001 helpers still report success",calls)}
