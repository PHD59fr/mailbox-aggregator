{
  "name": "mail-aggregator-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:interop": "node ../tests/opaque-interop.mjs",
    "lint": "eslint . --max-warnings=0",
    "test:browser": "node ../tests/browser-drafts.mjs && node ../tests/browser-navigation.mjs",
    "test:build": "node ../tests/check-web-build.mjs",
    "test:lifecycle": "node ../tests/account-lifecycle.mjs",
    "test:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@serenity-kit/opaque": "1.1.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "pinia": "3.0.3",
    "vue": "3.5.44",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.9.1",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.8.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "vue-tsc": "3.1.1"
  }
}
